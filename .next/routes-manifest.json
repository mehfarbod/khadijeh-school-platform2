{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/[entity]",
      "regex": "^/admin/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPentity": "nxtPentity"
      },
      "namedRegex": "^/admin/(?<nxtPentity>[^/]+?)(?:/)?$"
    },
    {
      "page": "/courses/[slug]",
      "regex": "^/courses/([^/]+?)(?:/)?$",
